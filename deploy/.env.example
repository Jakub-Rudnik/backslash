# Copy to deploy/.env and fill in. Secrets: openssl rand -hex 32

# Caddy site address: a domain gets HTTPS from Let's Encrypt (ports 80 and 443 must be reachable).
# Behind a tunnel that terminates TLS (Cloudflare Tunnel, tailscale serve) use ":80".
SITE_ADDRESS=latex.example.com
# URL users open in the browser
PUBLIC_URL=https://latex.example.com
# host ports; prefix with 127.0.0.1: to only accept connections from this machine (tunnels)
HTTP_PORT=80
HTTPS_PORT=443
# proxies in front of Caddy whose X-Forwarded-For is trusted, e.g. private_ranges for a tunnel on
# this machine; empty when Caddy faces the internet directly
TRUSTED_PROXIES=

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
INTERNAL_SECRET=

# optional: GitHub login (callback: <PUBLIC_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# optional: password reset mails, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="backslash <no-reply@example.com>"

MAX_PROJECTS_PER_USER=100
MAX_STORAGE_PER_USER_MB=1024
COMPILE_CONCURRENCY=2

{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle_path /collab* {
		reverse_proxy collab:1234
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# optional: GitHub login (callback: <PUBLIC_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID = ""
GITHUB_CLIENT_SECRET = ""
COLLAB_INTERNAL_URL = "http://127.0.0.1:1235"
# shared with collab; openssl rand -base64 32
INTERNAL_SECRET = ""
COMPILE_DIR = "../../.data/compiles"
BLOB_DIR = "../../.data/blobs"

MAX_PROJECTS_PER_USER = 100
MAX_STORAGE_PER_USER_MB = 1024
